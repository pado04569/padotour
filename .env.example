# 환경변수 예시 파일 (실제 값 아님 — 참고용)
# 실제 값은 .env.local 에 넣고, 운영 사이트는 Vercel 대시보드 > Settings > Environment Variables 에 넣으세요.

# 관리자 로그인 비밀번호
ADMIN_PASSWORD=여기에-새-비밀번호

# 예약문의 메일 발송 (resend.com > API Keys)
# 로컬에서는 비워 둬도 빌드된다. 비어 있으면 예약문의를 보낼 때만 500 오류가 난다.
# 운영 사이트(Vercel)에는 반드시 넣어야 문의 메일이 온다.
RESEND_API_KEY=

# 예약문의 카톡 알림톡 (솔라피 console.solapi.com)
# 여섯 개가 모두 있어야 보낸다. 하나라도 비면 카톡은 건너뛰고 메일만 간다.
SOLAPI_API_KEY=            # 솔라피 > API Key 관리
SOLAPI_API_SECRET=         # 솔라피 > API Key 관리 (발급 때 한 번만 보인다)
SOLAPI_PF_ID=              # 솔라피 > 카카오 채널 > @pado-tour 의 채널 ID (KA01PF 로 시작)
SOLAPI_TEMPLATE_ID=        # 솔라피 > 알림톡 템플릿 "예약문의 접수" 의 템플릿 ID (KA01TP 로 시작)
SOLAPI_FROM=               # 솔라피에 등록한 발신번호 — 카톡 실패 시 문자 대체발송에 쓴다
INQUIRY_NOTIFY_TO=         # 알림을 받을 휴대폰 번호 (사장님)
